#importing dataset from load_digits and visualising via matplotlib 
from sklearn.datasets import load_digits 
import matplotlib.pyplot as mpt
digit=load_digits()
fig,ax=mpt.subplots(2,5,figsize=(10,5))
for i,ax in enumerate(ax.flat):
    ax.imshow(digit.images[i], cmap='gray')
    ax.set_title(f"Label: {digit.target[i]}")
    ax.axis('off')
mpt.show()

#Training and Testing Data
from sklearn.model_selection import train_test_split
x_train,x_test,y_train,y_test=train_test_split(digit.data,digit.target,test_size=0.2, random_state=40)

#Training the Data RandomForestClassifier

fromfrom sklearn.ensemble import RandomForestClassifier
model=RandomForestClassifier(n_estimators=100,random_state=40)
model.fit(x_train,y_train)
model.score(x_test,y_test)

#Evaluating with a confusion matrix

from sklearn.metrics import accuracy_score, confusion_matrix
import seaborn as sns

y_pred = model.predict(x_test)

accuracy = accuracy_score(y_test, y_pred)
print(f"Accuracy: {accuracy * 100:.2f}%")

cm = confusion_matrix(y_test, y_pred)
mpt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
mpt.xlabel("Predicted")
mpt.ylabel("Actual")
mpt.title("Confusion Matrix — Digit Classifier")
mpt.show()

#Prediciting one sample image
sample=x_test[0].reshape(1,-1)
prediction=model.predict(sample)
actual=y_test[0]
mpt.imshow(x_test[0].reshape(8,8),cmap='gray')
mpt.title(f"Predicted: {prediction[0]}  |  Actual: {actual}")
mpt.axis('off')
mpt.show()
